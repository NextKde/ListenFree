# An optional prepared SDK keeps patched Qmmp and TagLib out of system paths.
# The application can also be configured with the individual LISTENFREE_* paths.
if(LISTENFREE_FLATPAK_BUILD)
    if(LISTENFREE_SDK OR DEFINED ENV{LISTENFREE_SDK} OR KOS_LISTENFREE_SDK OR DEFINED ENV{KOS_LISTENFREE_SDK})
        message(FATAL_ERROR "Sandbox builds require declared dependency paths, not an inherited host SDK")
    endif()
    return()
endif()
set(LISTENFREE_SDK "$ENV{LISTENFREE_SDK}" CACHE PATH "Private SDK containing prefix, deps/usr and vendor")
# Retain the explicit legacy dependency variable, not any NextKDE source paths.
if(NOT LISTENFREE_SDK AND (KOS_LISTENFREE_SDK OR DEFINED ENV{KOS_LISTENFREE_SDK}))
    set(LISTENFREE_SDK "${KOS_LISTENFREE_SDK}")
    if(NOT LISTENFREE_SDK)
        set(LISTENFREE_SDK "$ENV{KOS_LISTENFREE_SDK}")
    endif()
endif()
if(NOT LISTENFREE_SDK AND EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/.build/listenfree-sdk/prefix")
    set(LISTENFREE_SDK "${CMAKE_CURRENT_SOURCE_DIR}/.build/listenfree-sdk")
endif()
if(LISTENFREE_SDK)
    foreach(_component WebEngineWidgets WebEngineCore WebEngineCoreTools WebChannel Positioning)
        set(_config "${LISTENFREE_SDK}/deps/usr/lib/${CMAKE_LIBRARY_ARCHITECTURE}/cmake/Qt6${_component}")
        if(EXISTS "${_config}/Qt6${_component}Config.cmake" AND NOT Qt6${_component}_DIR)
            set(Qt6${_component}_DIR "${_config}" CACHE PATH "SDK Qt component" FORCE)
        endif()
    endforeach()
    list(PREPEND CMAKE_PREFIX_PATH "${LISTENFREE_SDK}/prefix" "${LISTENFREE_SDK}/deps/usr")
    set(LISTENFREE_QMMP_SOURCE_ROOT "${LISTENFREE_SDK}/vendor/qmmp-2.4.1" CACHE PATH "Patched Qmmp source")
    set(LISTENFREE_QMMP_LIBRARY "${LISTENFREE_SDK}/prefix/lib/libqmmp.so" CACHE FILEPATH "Qmmp library")
    set(LISTENFREE_QMMP_RUNTIME "${LISTENFREE_SDK}/prefix/lib/libqmmp.so" CACHE FILEPATH "Qmmp runtime")
    set(LISTENFREE_QMMP_UI_LIBRARY "${LISTENFREE_SDK}/prefix/lib/libqmmpui.so" CACHE FILEPATH "Qmmp UI library")
    set(LISTENFREE_QMMP_PLUGIN_ROOT "${LISTENFREE_SDK}/prefix/lib/qmmp-2.4" CACHE PATH "Patched Qmmp plugins")
    set(LISTENFREE_LIVE_FFMPEG_ROOT "${LISTENFREE_SDK}/deps/usr" CACHE PATH "FFmpeg prefix")
    set(OPENSSL_ROOT_DIR "${LISTENFREE_SDK}/deps/usr" CACHE PATH "OpenSSL prefix")
endif()
